{
  "entities": {
    "routeNotice": {
      "title": "Route Notice",
      "description": "Real-time updates regarding telecom fiber routes, outages, and plant notices",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 120 },
        "route": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["active", "investigating", "resolved"] },
        "description": { "type": "string", "maxLength": 500 },
        "author": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "route", "status", "description"]
    },
    "workOrder": {
      "title": "Work Order Record",
      "description": "Saved work order mask generated by operator",
      "type": "object",
      "properties": {
        "operatorName": { "type": "string", "maxLength": 80 },
        "scheduleDate": { "type": "string", "maxLength": 30 },
        "period": { "type": "string", "maxLength": 50 },
        "routerType": { "type": "string", "maxLength": 50 },
        "onuType": { "type": "string", "maxLength": 50 },
        "contactPhone": { "type": "string", "maxLength": 30 },
        "contactSuccess": { "type": "boolean" },
        "clientSince": { "type": "string", "maxLength": 50 },
        "motive": { "type": "string", "maxLength": 1000 },
        "onuSignal": { "type": "string", "maxLength": 50 },
        "logs": { "type": "string", "maxLength": 2000 },
        "recentHistory": { "type": "object" },
        "exceptionAuth": { "type": "object" },
        "generatedMask": { "type": "string", "maxLength": 4000 },
        "createdAt": { "type": "string" }
      },
      "required": ["operatorName", "scheduleDate", "period", "motive", "generatedMask"]
    }
  },
  "firestore": {
    "/routeNotices/{noticeId}": {
      "schema": { "$ref": "#/entities/routeNotice" },
      "description": "Collection of route alerts and shift announcements"
    },
    "/workOrders/{workOrderId}": {
      "schema": { "$ref": "#/entities/workOrder" },
      "description": "Collection of logged work order templates"
    }
  }
}
